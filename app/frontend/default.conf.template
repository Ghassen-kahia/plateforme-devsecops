# Modèle traité au démarrage par l'image officielle Nginx (envsubst) : seules les variables
# d'environnement définies (BACKEND_HOST, BACKEND_PORT) sont remplacées, pas $host ni $uri.
# Configuration Nginx : sert le frontend statique et relaie /api et /ready vers l'API FastAPI.
# Un seul point d'entrée pour le navigateur → pas de CORS à gérer.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;   # ne pas divulguer la version de Nginx

    # En-têtes de sécurité
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ ^/(api/|ready$) {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    # Sonde propre au conteneur frontend (ne dépend pas de l'API)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
